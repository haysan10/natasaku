<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F766E"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOKUS HARI INI"
        android:textSize="10sp"
        android:textColor="#CCFBF1"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_advice"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:text="Catat transaksimu!"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sisa 0 hari · Aman"
        android:textSize="10sp"
        android:textColor="#CCFBF1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_action_1"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+10k"
            android:textStyle="bold"
            android:textColor="#0F766E"
            android:background="#CCFBF1" />

        <TextView
            android:id="@+id/btn_action_2"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="Cek"
            android:textStyle="bold"
            android:textColor="#0F766E"
            android:background="#CCFBF1" />
    </LinearLayout>
</LinearLayout>
