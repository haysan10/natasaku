<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Frosted dark glass semi-transparent background (75% opacity dark navy) -->
    <solid android:color="#CF0F172A" />
    
    <!-- Semi-transparent white/teal border -->
    <stroke
        android:width="1.5dp"
        android:color="#35FFFFFF" />
        
    <!-- Smooth large corner radius -->
    <corners android:radius="24dp" />
</shape>
