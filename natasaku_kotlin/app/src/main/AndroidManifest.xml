<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".NataSakuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NataSaku">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NataSaku.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Custom Deep Link URI Schema for Widget Deep Links -->
            <intent-filter android:label="NataSaku Deep Link">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="natasaku" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.ExpenseReminderReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.natasaku.app.reminder.ACTION_CHECK_DAILY_EXPENSE" />
                <action android:name="com.natasaku.app.reminder.ACTION_QUICK_ADD_INPUT" />
                <action android:name="com.natasaku.app.reminder.ACTION_SNOOZE_2H" />
                <action android:name="com.natasaku.app.reminder.ACTION_MARK_DONE_TODAY" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- NataSaku Premium Home Widgets -->
        <receiver
            android:name=".widget.MiniStatusWidgetProvider"
            android:label="NataSaku Sisa Hari Ini (2x1)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.natasaku.app.widget.ACTION_TOGGLE_BALANCE" />
                <action android:name="com.natasaku.app.widget.ACTION_CYCLE_STATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_mini_status" />
        </receiver>

        <receiver
            android:name=".widget.QuickAddWidgetProvider"
            android:label="NataSaku Aksi Cepat (2x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_quick_add" />
        </receiver>

        <receiver
            android:name=".widget.DailyBudgetWidgetProvider"
            android:label="NataSaku Jatah Harian (3x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.natasaku.app.widget.ACTION_CYCLE_STATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_daily_budget" />
        </receiver>

        <receiver
            android:name=".widget.SavingGoalWidgetProvider"
            android:label="NataSaku Tabungan Celengan (3x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.natasaku.app.widget.ACTION_CYCLE_STATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_saving_goal" />
        </receiver>

        <receiver
            android:name=".widget.WeeklySpendingWidgetProvider"
            android:label="NataSaku Pengeluaran Mingguan (4x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.natasaku.app.widget.ACTION_CYCLE_STATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_weekly_spending" />
        </receiver>

        <receiver
            android:name=".widget.FinancialSummaryWidgetProvider"
            android:label="NataSaku Ringkasan Bulan Ini (4x3)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.natasaku.app.widget.ACTION_CYCLE_STATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_financial_summary" />
        </receiver>

        <receiver
            android:name=".widget.SmartAssistantWidgetProvider"
            android:label="NataSaku Smart Assistant (4x4)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.natasaku.app.widget.ACTION_CYCLE_STATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_smart_assistant" />
        </receiver>
    </application>

</manifest>
