<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_glass_bg">

    <!-- 1. NORMAL STATE LAYOUT -->
    <LinearLayout
        android:id="@+id/layout_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="visible">

        <!-- Left Column: Info & Stats -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_widget_chart"
                    android:contentDescription="Weekly Icon" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Pengeluaran 7 Hari"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_weekly_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rp190.000"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_weekly_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Aman"
                android:textColor="#15803D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/widget_badge_aman_bg" />
        </LinearLayout>

        <!-- Right Column: Vertical Bar Chart constructed using RemoteViews weight structures -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:orientation="horizontal"
            android:gravity="bottom">

            <!-- Day 1: Monday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <!-- Spacing weight: dynamically adjusted to match budget value -->
                <View
                    android:id="@+id/bar_space_day1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="80" />
                <View
                    android:id="@+id/bar_fill_day1"
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="20"
                    android:background="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="S"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Day 2: Tuesday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <View
                    android:id="@+id/bar_space_day2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="65" />
                <View
                    android:id="@+id/bar_fill_day2"
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="35"
                    android:background="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="S"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Day 3: Wednesday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <View
                    android:id="@+id/bar_space_day3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="85" />
                <View
                    android:id="@+id/bar_fill_day3"
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="15"
                    android:background="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="R"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Day 4: Thursday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <View
                    android:id="@+id/bar_space_day4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="50" />
                <View
                    android:id="@+id/bar_fill_day4"
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="50"
                    android:background="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="K"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Day 5: Friday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <View
                    android:id="@+id/bar_space_day5"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="60" />
                <View
                    android:id="@+id/bar_fill_day5"
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="40"
                    android:background="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="J"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Day 6: Saturday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <View
                    android:id="@+id/bar_space_day6"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="70" />
                <View
                    android:id="@+id/bar_fill_day6"
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="30"
                    android:background="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="S"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Day 7: Sunday -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <View
                    android:id="@+id/bar_space_day7"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="100" />
                <View
                    android:id="@+id/bar_fill_day7"
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="0"
                    android:background="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="M"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- 2. LOADING STATE LAYOUT -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#0D9488" />
    </LinearLayout>

</RelativeLayout>
